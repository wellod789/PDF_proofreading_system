# 改行コードの自動変換設定
* text=auto

# テキストファイルの明示的な指定
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.env.example text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.spec text eol=lf

# バイナリファイル
*.pdf binary
*.exe binary
*.dll binary
*.pyd binary
*.pyc binary
*.pyo binary
*.zip binary
*.tar.gz binary
*.rar binary
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# その他
*.log text eol=lf

